<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>SportsFacilityServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.SportsFacilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SportsFacilityServlet</servlet-name>
        <url-pattern>/facilities</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TimeSlotServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.TimeSlotServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TimeSlotServlet</servlet-name>
        <url-pattern>/slots</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingServlet</servlet-name>
        <servlet-class>ua.edu.nupp.kpp.server.BookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingServlet</servlet-name>
        <url-pattern>/bookings</url-pattern>
    </servlet-mapping>

</web-app>